# Supabase project reference ID
# Source: Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Must match the same project as SUPABASE_PROJECT_ID
# https://<SUPABASE_PROJECT_ID>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard → Project Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...or.sb_secret_...

# Required for `npm run db:migrate` (Dashboard → Project Settings → Database → password)
SUPABASE_DB_PASSWORD=
# AWS region of the project (Dashboard → General → Region), e.g. ap-south-1
SUPABASE_DB_REGION=ap-south-1
# Preferred: paste Session pooler URI from Dashboard → Connect (IPv4-safe)
# DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Used by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-long-password

# Resend — ALL outbound mail via Resend API (Auth hook + product emails)
# https://resend.com/api-keys — verify your domain first
# Auth: npm run db:sync-auth-emails (enables Supabase Send Email Hook → /api/auth/send-email → Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Assessa <hello@your-verified-domain.com>
# Auto-generated by db:sync-auth-emails if missing
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...
# Optional: Supabase Auth email-send rate limit (emails/hour)
# SUPABASE_RATE_LIMIT_EMAIL_SENT=100
APP_URL=https://assessa.sstcloud.com.au

# AI insights (dashboard + admin) — Google AI Studio
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional OpenAI-compatible fallback (e.g. OpenRouter)
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
# AI_GATEWAY_MODEL=google/gemini-3.5-flash-lite

# Management API token for sync scripts
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...

# Google sign-in (Google Cloud OAuth Web client → Supabase Auth)
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<SUPABASE_PROJECT_ID>.supabase.co/auth/v1/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
